# Copie para .env na raiz do repositório. Variáveis do processo têm prioridade.
# Nunca versionar .env — ele pode conter caminhos e preferências locais.

# Endereço do servidor Ollama. IPv4 evita a resolução IPv6 no Windows.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Modelo usado pelo backend (deve estar instalado: ollama pull <modelo>).
# Tool calling (read_file) exige um modelo com suporte a functions, por exemplo:
# PI_MODEL=qwen3-6b-iq2-local
PI_MODEL=qwen3.8-2b-local

# Caminho opcional do executável; vazio = PATH + locais conhecidos.
# OLLAMA_EXECUTABLE=

# Inicia "ollama serve" se o servidor local não responder (1/0).
OLLAMA_AUTO_START=1

# Ollama fica aberto entre execuções e é reutilizado; só inicie outro se não houver.
# Opt-in: encerrar ao sair apenas o "ollama serve" iniciado pelo Pi (1/0).
# OLLAMA_STOP_ON_EXIT=0

# Nível de log do Pi.Host: Trace, Debug, Information, Warning, Error, Critical.
PI_LOG_LEVEL=Information

# Janela de contexto estimada do modelo.
PI_CONTEXT_WINDOW_TOKENS=32768

# Diretório dos snapshots de sessão (relativo ao cwd ou absoluto).
PI_SESSION_DIR=.pi-ia/sessions

# Habilita a ferramenta execute_shell. Desligada por padrão por segurança (1/0).
PI_ALLOW_SHELL=0

# Logs de diagnóstico em artifacts/debug/ (1/0) e diretório alternativo.
PI_DEBUG=0
# PI_DEBUG_LOG_DIR=

# Arquivo de log do Pi.Host (caminho relativo à raiz ou absoluto).
PI_HOST_LOG=artifacts/debug/pi-host.log

# Raiz do sandbox das ferramentas de arquivo. Padrão: diretório atual.
# PI_WORKSPACE=

# Sobrescreve o DLL usado pela TUI (útil em testes).
# PI_BACKEND_DLL=

# Encerramento sem abrir a TUI (validação de ambiente/CI).
# PI_SKIP_TUI=1

# Porta do inspector do Bun quando iniciado pelo Pi.Host.
# PI_TUI_INSPECT=9229
