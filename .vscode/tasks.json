{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-debug",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Pi.sln",
        "--configuration",
        "Debug"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test-debug",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/Pi.sln",
        "--configuration",
        "Debug"
      ],
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "tui-install",
      "type": "process",
      "command": "bun",
      "args": [
        "install",
        "--frozen-lockfile"
      ],
      "options": {
        "cwd": "${workspaceFolder}/src/Pi.Tui"
      },
      "problemMatcher": []
    },
    {
      "label": "debug-prep",
      "dependsOn": ["build-debug", "tui-install"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
