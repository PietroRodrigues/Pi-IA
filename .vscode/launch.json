{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Pi.CLI — Debug",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-debug",
      "program": "${workspaceFolder}/artifacts/bin/Pi.CLI/debug/Pi.CLI.dll",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Pi.CLI — Debug + logs",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-debug",
      "program": "${workspaceFolder}/artifacts/bin/Pi.CLI/debug/Pi.CLI.dll",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Pi.CLI — Sem auto-start",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-debug",
      "program": "${workspaceFolder}/artifacts/bin/Pi.CLI/debug/Pi.CLI.dll",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "env": {
        "Ollama__AutoStart": "false"
      }
    },
    {
      "name": "Pi.CLI — Anexar ao processo",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}
