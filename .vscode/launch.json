{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Pi — Debug (tudo)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/artifacts/bin/Pi.Host/debug/Pi.Host.dll",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "debug-prep",
      "stopAtEntry": false,
      "env": {
        "PI_DEBUG": "1",
        "DOTNET_ENVIRONMENT": "Development",
        "PI_TUI_INSPECT": "9229"
      }
    },
    {
      "name": "Pi.Host — Anexar ao backend",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    },
    {
      "name": "TUI — Attach (9229)",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": false,
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "Pi — Debug (C# + TUI)",
      "configurations": ["Pi — Debug (tudo)", "TUI — Attach (9229)"],
      "stopAll": true
    }
  ]
}
